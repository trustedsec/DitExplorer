<Window x:Class="DitExplorer.WpfApp.CredentialExtractorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DitExplorer.CredentialExtraction"
        xmlns:b="clr-namespace:DitExplorer.UI.Behaviors;assembly=DitExplorer.UI.Core" d:DataContext="{d:DesignInstance Type=local:CredentialExtractorViewModel}"
		b:CommandFrame.CommandHandler="{Binding}"
		FocusManager.FocusedElement="{Binding ElementName=bootkeyBox}"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="550" Width="800">
	<Grid Margin="3">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock
			TextWrapping="Wrap"
			Text="To decrypt the credentials for the selected objects, enter the boot key as a series of hexadecimal digits without spaces."
			Margin="3"
			/>

		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="6"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="6"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<AccessText Text="_System key:" VerticalAlignment="Center" Margin="3"/>
			<TextBox
				Grid.Column="2"
				Width="250"
				x:Name="bootkeyBox"
				HorizontalAlignment="Left"
				Text="{Binding SystemKey, UpdateSourceTrigger=PropertyChanged}"
				VerticalAlignment="Center"
				Margin="3"/>

			<Button
				Grid.Column="4"
				Margin="3"
				Padding="3"
				Content="_Extract from Hive..."
				Command="{x:Static local:CredentialExtractorViewModel.ExtractSyskeyCommand}"
				/>

			<TextBlock
				Grid.Row="1"
				Grid.Column="2"
				Text="{Binding SystemKeyError}"
				Foreground="Red"
				TextWrapping="Wrap"
				/>
		</Grid>

		<Grid
			Grid.Row="2"
			>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="6"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="100"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<ListView
				Margin="3"
				ItemsSource="{Binding Nodes}"
				b:ListViewSorting.IsSortingEnabled="True"
				>
				<ListView.View>
					<GridView>
						<GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
						<GridViewColumn Header="Logon Name" DisplayMemberBinding="{Binding sAMAccountName}"/>
						<GridViewColumn Header="UPN" DisplayMemberBinding="{Binding upn}"/>
						<GridViewColumn Header="DN" DisplayMemberBinding="{Binding DistinguishedName}"/>
					</GridView>
				</ListView.View>
			</ListView>

			<GroupBox
				Grid.Column="2"
				Grid.RowSpan="2"
				Header="_Options"
				Padding="3"
				>
				<StackPanel>
					<CheckBox Content="Include _all" IsChecked="{Binding IncludeAll}"/>
					<CheckBox Content="Include _NT/LM" IsChecked="{Binding IncludeNtLm}"/>
					<CheckBox Content="Include NT/LM _history" IsChecked="{Binding IncludeNtLmHistory}"/>
					<CheckBox Content="Include _WDigest" IsChecked="{Binding IncludeWDigest}"/>
					<CheckBox Content="Include _Kerberos" IsChecked="{Binding IncludeKerberos}"/>
					<CheckBox Content="Include ol_d Kerberos" IsChecked="{Binding IncludeKerberosOld}"/>
					<CheckBox Content="Include _cleartext password" IsChecked="{Binding IncludeCleartextPassword}"/>
					<CheckBox Content="Include s_trong NTOWF key" IsChecked="{Binding IncludeStrongNtowfKey}"/>
				</StackPanel>
			</GroupBox>
		</Grid>


		<StackPanel Grid.Row="3" Orientation="Horizontal">
			<Button Content="_Extract Credentials" Padding="3" Margin="3" IsDefault="True" Command="{x:Static local:CredentialExtractorViewModel.ExtractCommand}"/>
		</StackPanel>

		<GroupBox Grid.Row="4" Margin="3" Header="Results">
			<DockPanel>
				<ToolBarTray DockPanel.Dock="Top">
					<ToolBar>
						<Button Command="{x:Static local:CredentialExtractorViewModel.ExportCommand}">
							<AccessText Text="{x:Static local:Messages.Export_Command}"/>
						</Button>
					</ToolBar>
				</ToolBarTray>
				<ListView Margin="3"
						  ItemsSource="{Binding Credentials}"
						  b:ListViewSorting.IsSortingEnabled="True" d:ItemsSource="{d:SampleData ItemCount=5}"
						  >
					<ListView.View>
						<GridView>
							<GridViewColumn Header="Logon Name" DisplayMemberBinding="{Binding LogonName}"/>
							<GridViewColumn Header="Cred. Type" DisplayMemberBinding="{Binding Label}"/>
							<GridViewColumn Header="Credential" DisplayMemberBinding="{Binding Text}"/>
							<GridViewColumn Header="UPN" DisplayMemberBinding="{Binding Upn}"/>
							<GridViewColumn Header="DN" DisplayMemberBinding="{Binding DistinguishedName}"/>
							<GridViewColumn Header="Error" DisplayMemberBinding="{Binding ErrorDetails}"/>
						</GridView>
					</ListView.View>
				</ListView>
			</DockPanel>
		</GroupBox>
	</Grid>
</Window>
