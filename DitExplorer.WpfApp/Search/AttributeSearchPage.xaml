<UserControl x:Class="DitExplorer.UI.WpfApp.Search.AttributeSearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DitExplorer.UI.WpfApp.Search" d:DataContext="{d:DesignInstance Type=local:AttributeSearchHandler}"
			 xmlns:b="clr-namespace:DitExplorer.UI.Behaviors;assembly=DitExplorer.UI.Core"
			 b:CommandFrame.CommandHandler="{Binding}"
			 mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid Margin="6">
		<ItemsControl
			ItemsSource="{Binding Conditions}"
			Grid.IsSharedSizeScope="True"
			KeyboardNavigation.TabNavigation="Local"
			>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="attr" MinWidth="150"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="op"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<ComboBox
							SelectedItem="{Binding Attribute}"
							ItemsSource="{Binding AttributeList}"
							/>

						<ComboBox
							x:Name="opBox"
							Grid.Column="1"
							SelectedItem="{Binding SelectedOperator}"
							ItemsSource="{Binding OperatorList}"
							/>

						<ComboBox
							IsEditable="True"
							x:Name="valueBox"
							Grid.Column="2"
							Text="{Binding Criterion, UpdateSourceTrigger=PropertyChanged}"
							ItemsSource="{Binding Suggestions}"
							MinWidth="300"
							/>

						<TextBlock
							x:Name="deleteLink"
							Visibility="Hidden"
							Grid.Column="3"
							>
							<Hyperlink Command="{x:Static ApplicationCommands.Delete}" CommandParameter="{Binding}">
								<TextBlock Text="Delete"/>
							</Hyperlink>
						</TextBlock>
					</Grid>
					<DataTemplate.Triggers>
						<DataTrigger Binding="{Binding CanDelete}" Value="True">
							<Setter TargetName="deleteLink" Property="Visibility" Value="Visible"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding Attribute}" Value="{x:Null}">
							<Setter TargetName="opBox" Property="Visibility" Value="Hidden"/>
							<Setter TargetName="valueBox" Property="Visibility" Value="Hidden"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding RequiresValueEntry}" Value="False">
							<Setter TargetName="valueBox" Property="Visibility" Value="Hidden"/>
						</DataTrigger>
					</DataTemplate.Triggers>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</UserControl>
