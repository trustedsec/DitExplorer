<UserControl x:Class="DitExplorer.UI.WpfApp.Search.SidSearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DitExplorer.UI.WpfApp.Search"
             mc:Ignorable="d" 
			 FocusManager.IsFocusScope="True"
			 FocusManager.FocusedElement="{Binding ElementName=sidBox}"
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid Margin="3" VerticalAlignment="Top">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="6"/>
			<ColumnDefinition Width="400"/>
		</Grid.ColumnDefinitions>

		<TextBlock Text="SID:"/>

		<TextBox
			x:Name="sidBox"
			Grid.Column="2"
			Text="{Binding SearchSid, UpdateSourceTrigger=PropertyChanged}"
			/>
	</Grid>
</UserControl>
